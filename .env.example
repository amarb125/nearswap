# --- Core ---
DATABASE_URL="postgresql://nearswap:nearswap@localhost:5432/nearswap"
APP_URL="http://localhost:3000"
APP_NAME="Nearswap"
# generate with: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
CRON_SECRET="change-me-too-16+chars"
# Phone numbers (E.164) that become admins when they log in
ADMIN_PHONES="+919999999999"

# --- Business rules (amounts in paise; 100 paise = ₹1) ---
FEE_BPS=500                 # 5% commission charged to the seller
FEE_MIN_PAISE=1000          # minimum ₹10
FEE_MAX_PAISE=50000         # maximum ₹500
NOSHOW_COMP_BPS=500         # buyer no-show: 5% of price to seller...
NOSHOW_COMP_MAX_PAISE=10000 # ...capped at ₹100
PAYMENT_WINDOW_MINUTES=30   # time to pay after reserving
MEETUP_DEADLINE_HOURS=72    # handover must happen within this after payment
NOSHOW_CONTEST_HOURS=24

# --- Payments: "mock" (dev only) or "razorpay" ---
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- SMS OTP: "console" (dev only), "msg91" (India, DLT) or "twilio" ---
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Image storage: "local" or "s3" (AWS S3, Cloudflare R2, etc.) ---
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
NEXT_PUBLIC_APP_NAME="Nearswap"
